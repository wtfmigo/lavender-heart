/.impeccable/critique/

# New personal photos stay local unless explicitly approved and added with git add -f.
# The owner-approved website images are already tracked for Vercel builds.
/frontend/public/photos/personal/
/.private-content/

# Visual-review captures can contain personal photographs; keep them local.
/docs/evidence/**/*.png
/docs/evidence/**/*.jpg
/docs/evidence/**/*.jpeg
/docs/evidence/**/*.webp
/docs/evidence/**/*.avif
/docs/evidence/**/*.gif
/docs/evidence/**/*.mp4
/docs/evidence/**/*.mov
/docs/evidence/scroll-gallery-repair/
/docs/evidence/visual-quality/
